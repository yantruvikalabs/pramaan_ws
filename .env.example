# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Development MySQL runs in Docker on 3307 so it does not collide with a
# system MySQL on 3306:
#   docker run -d --name pramaan-mysql \
#     -e MYSQL_ROOT_PASSWORD=pramaan -e MYSQL_DATABASE=pramaan \
#     -e MYSQL_USER=pramaan -e MYSQL_PASSWORD=pramaan \
#     -p 3307:3306 mysql:8.0
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=pramaan
DB_PASSWORD=pramaan
DB_NAME=pramaan

# Production refuses to start with the dev fallback.
JWT_SECRET=dev-only-do-not-use-in-production
JWT_EXPIRES_IN=30d

OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
# "log" prints the code instead of sending an SMS. Production refuses this.
# O-5 (notification transport) is open and has a weeks-long lead time.
OTP_DELIVERY=log

# White-label by configuration, never a code fork. FRD NFR-7.
BRAND_NAME=Pramaan
CONTRACTOR_NAME=Demo Contractor

CORS_ORIGINS=http://localhost:3000
