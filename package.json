  },
  "dependencies": {
    "@pramaan/shared": "*",
    "cors": "^2.8.6",
    "csv-parse": "^5.5.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.11.4",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^3.23.8"
  }
}
