{
  "name": "@pramaan/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "test:tz": "for tz in Asia/Kolkata UTC America/New_York; do echo \"-- TZ=$tz\"; TZ=$tz node --test test/*.test.js || exit 1; done",
    "db:migrate": "node src/db/mongo-migrate.js",
    "db:migrate:mongo": "node src/db/mongo-migrate.js",
    "test:mongo-schema": "node test/mongo-schema.mjs",
    "migrate:to-mongo": "node tools/migrate-to-mongo.mjs",
    "db:seed": "node src/db/seed.js",
    "db:bootstrap": "node src/db/bootstrap.js",
    "gate1": "RATE_LIMIT_OTP_REQUEST=60 node test/gate1.mjs",
    "gate2": "RATE_LIMIT_OTP_REQUEST=60 node test/gate2.mjs",
    "d1": "node tools/d1-byte-fidelity.mjs",
    "d1:tz": "for tz in Asia/Kolkata UTC America/New_York; do TZ=$tz node tools/d1-byte-fidelity.mjs || exit 1; done",
    "d2": "node test/chain-concurrency.mjs",
    "d2:throughput": "DB_NAME=pramaan_bench node tools/d2-throughput.mjs",
    "db:migrate:mysql": "node src/db/migrate.js"
  },
  "dependencies": {
    "@pramaan/shared": "*",
    "cors": "^2.8.6",
    "csv-parse": "^5.5.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.5.0",
    "mysql2": "^3.11.4",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^3.23.8"
  }
}
